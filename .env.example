# =============================================================================
# OULAD Analytics Platform — Environment Configuration
# =============================================================================

# Application
APP_NAME=oulad-analytics
APP_ENV=development
DEBUG=true

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=oulad_analytics
POSTGRES_USER=oulad_user
POSTGRES_PASSWORD=change_me_in_production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# JWT Authentication
JWT_SECRET_KEY=replace-with-a-64-char-random-string
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ML Model
MODEL_PATH=app/ml/model.joblib
MODEL_VERSION=1.0.0

# Frontend
VITE_API_URL=http://localhost:8000
